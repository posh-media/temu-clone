# Copy to .env.local and fill in your own Firebase web app credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: override the Firebase Functions region (default: us-central1).
# VITE_FIREBASE_FUNCTIONS_REGION=us-central1

# Optional: force Paystack on or off in any build.
# - true: call the real paystackInitialize/paystackVerify Cloud Functions.
# - false: use local simulation (useful for dev when functions are not deployed).
# In Vercel production builds this defaults to true if left unset.
# VITE_PAYSTACK_ENABLED=true

# Optional: flash sale duration in seconds (default: 600 = 10 minutes).
# VITE_FLASH_SALE_DURATION_SECONDS=600

# Optional: restart the flash sale countdown when it reaches zero.
# - true: starts a new countdown automatically.
# - false: promotion ends and cannot be claimed again.
# VITE_FLASH_SALE_RESTART_ON_TIMEOUT=false
